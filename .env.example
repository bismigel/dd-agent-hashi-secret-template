# Datadog API key written to Vault as secret/datadog#api_key.
# A dummy value is enough to test secret resolution and checks.
VAULT_DD_API_KEY=dummy-datadog-api-key

# Datadog site/region for your organization. The default is US5.
# Examples: datadoghq.com (US1), us3.datadoghq.com (US3),
# us5.datadoghq.com (US5), datadoghq.eu (EU), ap1.datadoghq.com (AP1).
# The API key must be from the same region as this site.
DD_SITE=us5.datadoghq.com

# Dev-only Vault token used by the compose file. In production use
# vault_session (Kubernetes/AppRole) instead of a root token.

# status-api image tag from GHCR (pin a tag in production).
STATUS_API_TAG=latest

# Seconds between secret refreshes. 60 is fine for the demo; increase in
# production.
DD_SECRET_REFRESH_INTERVAL=60
